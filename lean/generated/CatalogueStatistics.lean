theorem coreOrder_rightInverse : Function.RightInverse coreOrderInverse coreOrder := by
  have h : (List.finRange 4935).all (fun i => coreOrder (coreOrderInverse i) == i) = true := by decide +kernel
  intro i
  exact beq_iff_eq.mp (List.all_eq_true.mp h i (List.mem_finRange i))

theorem coreCodes_strictMono : StrictMono (fun i => coreCode (coresFast (coreOrder i))) := by
  apply Fin.strictMono_iff_lt_succ.mpr
  have h : (List.finRange 4934).all (fun i => decide
    (coreCode (coresFast (coreOrder i.castSucc)) < coreCode (coresFast (coreOrder i.succ)))) = true := by decide +kernel
  intro i
  exact of_decide_eq_true (List.all_eq_true.mp h i (List.mem_finRange i))

theorem cores_injective : Function.Injective cores := by
  intro a b hab
  have ha := coreOrder_rightInverse a
  have hb := coreOrder_rightInverse b
  have hc : coreCode (coresFast (coreOrder (coreOrderInverse a))) =
      coreCode (coresFast (coreOrder (coreOrderInverse b))) := by
    rw [ha, hb, coresFast_eq, hab]
  have hi := coreCodes_strictMono.injective hc
  simpa only [ha, hb] using congrArg coreOrder hi

theorem catalogue_pair_count :
    ((List.finRange 4935).filter (fun i => decide ((cores i).length = 2))).length = 2415 := by
  rw [← coresFast_eq]
  decide +kernel

theorem catalogue_triple_count :
    ((List.finRange 4935).filter (fun i => decide ((cores i).length = 3))).length = 2520 := by
  rw [← coresFast_eq]
  decide +kernel

theorem catalogue_core_lengths (i : Fin 4935) : (cores i).length = 2 ∨ (cores i).length = 3 := by
  have h : (List.finRange 4935).all (fun i =>
      (coresFast i).length == 2 || (coresFast i).length == 3) = true := by decide +kernel
  simpa only [Bool.or_eq_true, beq_iff_eq, coresFast_eq] using
    List.all_eq_true.mp h i (List.mem_finRange i)

theorem catalogue_core_sorted (i : Fin 4935) : (cores i).Pairwise (· < ·) := by
  have h : (List.finRange 4935).all (fun i =>
      decide ((coresFast i).Pairwise (· < ·))) = true := by decide +kernel
  have hi := of_decide_eq_true (List.all_eq_true.mp h i (List.mem_finRange i))
  simpa only [coresFast_eq] using hi

theorem catalogue_core_nodup (i : Fin 4935) : (cores i).Nodup :=
  (catalogue_core_sorted i).nodup

theorem coreSets_injective : Function.Injective (fun i => (cores i).toFinset) := by
  intro a b hab
  apply cores_injective
  apply (catalogue_core_sorted a).eq_of_mem_iff (catalogue_core_sorted b)
  intro m
  simpa only [List.mem_toFinset] using Finset.ext_iff.mp hab m

theorem distinct_coreSet_count :
    (Finset.univ.image (fun i : Fin 4935 => (cores i).toFinset)).card = 4935 := by
  rw [Finset.card_image_of_injective _ coreSets_injective]
  rfl

theorem catalogue_core_owned (i : Fin 4935) : i ∈ templates (coreOwner i) := by
  have h : (List.finRange 4935).all (fun i => (templates (coreOwner i)).contains i) = true := by decide +kernel
  exact List.contains_iff_mem.mp (List.all_eq_true.mp h i (List.mem_finRange i))

theorem catalogue_template_length (t : Fin 840) : (templates t).length = 105 := by
  have h : (List.finRange 840).all (fun t => (templates t).length == 105) = true := by decide +kernel
  exact beq_iff_eq.mp (List.all_eq_true.mp h t (List.mem_finRange t))

noncomputable def catalogueUnion : Finset (Finset (Fin 256)) :=
  Finset.univ.biUnion fun t : Fin 840 =>
    (templates t).toFinset.image (fun c => (cores c).toFinset)

theorem catalogueUnion_eq : catalogueUnion =
    Finset.univ.image (fun c : Fin 4935 => (cores c).toFinset) := by
  ext S
  constructor
  · intro hS
    obtain ⟨t, _, ht⟩ := Finset.mem_biUnion.mp hS
    obtain ⟨c, _, rfl⟩ := Finset.mem_image.mp ht
    exact Finset.mem_image.mpr ⟨c, Finset.mem_univ _, rfl⟩
  · intro hS
    obtain ⟨c, _, rfl⟩ := Finset.mem_image.mp hS
    apply Finset.mem_biUnion.mpr
    exact ⟨coreOwner c, Finset.mem_univ _, Finset.mem_image.mpr
      ⟨c, List.mem_toFinset.mpr (catalogue_core_owned c), rfl⟩⟩

theorem catalogue_union_count : catalogueUnion.card = 4935 := by
  rw [catalogueUnion_eq]
  exact distinct_coreSet_count

theorem catalogue_size_count (n : Nat) :
    (catalogueUnion.filter (fun C => C.card = n)).card =
      ((List.finRange 4935).filter (fun i => decide ((cores i).length = n))).length := by
  rw [catalogueUnion_eq, Finset.filter_image,
    Finset.card_image_of_injective _ coreSets_injective]
  simp_rw [List.toFinset_card_of_nodup (catalogue_core_nodup _)]
  have hu : (Finset.univ : Finset (Fin 4935)) = (List.finRange 4935).toFinset := by
    ext i
    simp
  rw [hu, List.filter_toFinset]
  exact List.toFinset_card_of_nodup ((List.nodup_finRange 4935).filter _)

theorem catalogue_union_pair_count :
    (catalogueUnion.filter (fun C => C.card = 2)).card = 2415 := by
  rw [catalogue_size_count]
  exact catalogue_pair_count

theorem catalogue_union_triple_count :
    (catalogueUnion.filter (fun C => C.card = 3)).card = 2520 := by
  rw [catalogue_size_count]
  exact catalogue_triple_count

