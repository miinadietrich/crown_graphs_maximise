theorem all_template_cores_minimal (t : Fin 840) (c : Fin 4935) (hc : c ∈ templates t) :
    MinimalInfeasible {r | r ∈ (cores c).map (fun m => rowOfMask (pairsOfEquiv (pairings t)) (maskBits m))} := by
  have hall (b : Fin 21) (r : Fin 40) (c' : Fin 4935) (hc' : c' ∈ templates (⟨40*b.val+r.val,by have hb := b.isLt; have hr := r.isLt; omega⟩ : Fin 840)) :
    MinimalInfeasible {q | q ∈ (cores c').map (fun m => rowOfMask (pairsOfEquiv (pairings (⟨40*b.val+r.val,by have hb := b.isLt; have hr := r.isLt; omega⟩ : Fin 840))) (maskBits m))} := by
    fin_cases b
    · exact all_template_cores_minimal_block0000 r c' hc'
    · exact all_template_cores_minimal_block0001 r c' hc'
    · exact all_template_cores_minimal_block0002 r c' hc'
    · exact all_template_cores_minimal_block0003 r c' hc'
    · exact all_template_cores_minimal_block0004 r c' hc'
    · exact all_template_cores_minimal_block0005 r c' hc'
    · exact all_template_cores_minimal_block0006 r c' hc'
    · exact all_template_cores_minimal_block0007 r c' hc'
    · exact all_template_cores_minimal_block0008 r c' hc'
    · exact all_template_cores_minimal_block0009 r c' hc'
    · exact all_template_cores_minimal_block0010 r c' hc'
    · exact all_template_cores_minimal_block0011 r c' hc'
    · exact all_template_cores_minimal_block0012 r c' hc'
    · exact all_template_cores_minimal_block0013 r c' hc'
    · exact all_template_cores_minimal_block0014 r c' hc'
    · exact all_template_cores_minimal_block0015 r c' hc'
    · exact all_template_cores_minimal_block0016 r c' hc'
    · exact all_template_cores_minimal_block0017 r c' hc'
    · exact all_template_cores_minimal_block0018 r c' hc'
    · exact all_template_cores_minimal_block0019 r c' hc'
    · exact all_template_cores_minimal_block0020 r c' hc'
  let b : Fin 21 := ⟨t.val/40,by omega⟩
  let r : Fin 40 := ⟨t.val%40,by omega⟩
  have ht : t = ⟨40*b.val+r.val,by have hb := b.isLt; have hr := r.isLt; omega⟩ := by
    apply Fin.ext
    dsimp [b,r]
    omega
  have h := hall b r c
  rw [←ht] at h
  exact h hc

theorem every_core_minimal (c : Fin 4935) :
    ∃ p : Pairing8, MinimalInfeasible {r | r ∈ (cores c).map (fun m => rowOfMask (pairsOfEquiv p) (maskBits m))} :=
  ⟨pairings (coreOwner c), all_template_cores_minimal (coreOwner c) c (catalogue_core_owned c)⟩

#print axioms all_template_cores_minimal
#print axioms every_core_minimal
end Crown.CertificateData
