import generated.CertificateAssignment
import Crown.CertificateAssembly

namespace Crown.CertificateData
open Crown.CertificateSemantics Crown.CertificateValuation Crown.CertificateAssembly
set_option maxRecDepth 100000
set_option maxHeartbeats 0

local instance : DecidableEq Sat.Literal := fun a b => by
  cases a <;> cases b <;> simp_all <;> infer_instance
local instance : DecidableEq Sat.Clause := inferInstanceAs (DecidableEq (List Sat.Literal))

theorem counter_1_1 (s : Fin 256 → Bool) :
    (valuation (assignment s)).satisfies_fmla (counterCNF (Sat.Literal.pos 257) (Sat.Literal.pos 256) (Sat.Literal.pos 0) (Sat.Literal.neg 256)) := by
  exact counter_gate s 0 0 (assignment s)
    (Sat.Literal.pos 257) (Sat.Literal.pos 256) (Sat.Literal.pos 0) (Sat.Literal.neg 256)
    rfl ((count_above s 0 1 (by decide)).symm) rfl ((count_zero s 0).symm)

theorem clause_2 (s : Fin 256 → Bool) :
    (valuation (assignment s)).satisfies [(Sat.Literal.neg 256), (Sat.Literal.pos 257)] := by
  exact gate_clause (assignment s) (counterCNF (Sat.Literal.pos 257) (Sat.Literal.pos 256) (Sat.Literal.pos 0) (Sat.Literal.neg 256))
    [(Sat.Literal.neg 256), (Sat.Literal.pos 257)] [(Sat.Literal.neg 256), (Sat.Literal.pos 257)] (List.Mem.head _) (by intro l hl; exact hl) (counter_1_1 s)

