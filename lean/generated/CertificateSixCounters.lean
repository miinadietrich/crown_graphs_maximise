local instance : DecidableEq Sat.Literal := fun a b => by
  cases a <;> cases b <;> simp_all <;> infer_instance
local instance : DecidableEq Sat.Clause := inferInstanceAs (DecidableEq (List Sat.Literal))

theorem counter_1_1 (s : Fin 64 → Bool) :
    (valuation (assignment s)).satisfies_fmla (counterCNF (Sat.Literal.pos 65) (Sat.Literal.pos 64) (Sat.Literal.pos 0) (Sat.Literal.neg 64)) := by
  exact counter_gate s 0 0 (assignment s)
    (Sat.Literal.pos 65) (Sat.Literal.pos 64) (Sat.Literal.pos 0) (Sat.Literal.neg 64)
    rfl ((count_above s 0 1 (by decide)).symm) rfl ((count_zero s 0).symm)

theorem clause_2 (s : Fin 64 → Bool) :
    (valuation (assignment s)).satisfies [(Sat.Literal.neg 64), (Sat.Literal.pos 65)] := by
  exact gate_clause (assignment s) (counterCNF (Sat.Literal.pos 65) (Sat.Literal.pos 64) (Sat.Literal.pos 0) (Sat.Literal.neg 64))
    [(Sat.Literal.neg 64), (Sat.Literal.pos 65)] [(Sat.Literal.neg 64), (Sat.Literal.pos 65)] (List.Mem.head _) (by intro l hl; exact hl) (counter_1_1 s)

