  have hall (b : Fin 21) (r : Fin 40) : ∃ c ∈ templates (⟨40*b.val+r.val,by have hb := b.isLt; have hr := r.isLt; omega⟩ : Fin 840), ∀ m ∈ cores c, s m = true := by
